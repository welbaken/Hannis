resource/*/frame_*.png
resource/*/manifest.json
# runtime
config.json
dist/
# Windows download zone marker
**/*:Zone.Identifier
# runtime logs / scratch media
maa.log
mp4/
# web tool runtime data (results expire)
web/mp4-keyer/data/
