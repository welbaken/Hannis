# toolchain (workspace-local)
.cargo/
.rustup/
.tools/
# build artifacts
app/target/
# scratch / analysis work (generated images, one-off scripts)
out/
# split frames (generated by tools/split_webp.py --legacy-split)
resource/*/frame_*.png
resource/*/manifest.json
# sprite sheets (generated at build time into dist/; not tracked)
resource/*.sheet.png
resource/*.sheet.json
# runtime
config.json
dist/
# Windows download zone marker
**/*:Zone.Identifier
